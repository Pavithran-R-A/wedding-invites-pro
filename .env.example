# Copy to `.env` for local development. Do NOT commit `.env`.
#
# These are BROWSER-PUBLIC Supabase settings (they ship to every visitor in
# the JS bundle). They are NOT secrets and are NOT equivalent to a
# service_role / secret key. Never place a service_role key, database
# password, or payment-provider secret key in a VITE_* variable here.

# Supabase project reference id (public)
VITE_SUPABASE_PROJECT_ID="your-project-ref"

# Full Supabase URL (public)
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"

# Supabase anon / publishable key (public browser key).
# Must be the ANON key only — never a service_role or secret key.
VITE_SUPABASE_PUBLISHABLE_KEY="public-anon-key"
