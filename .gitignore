# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Environment files — never commit real credentials / config
.env
.env.*
!.env.example

# Supabase CLI local-stack state (recreated by `db start`, holds local keys)
supabase/.temp/
supabase/.branches/

# Cloudflare wrangler scratch, written wherever the CLI is invoked from. It is rebuilt by the next
# run, and a `wrangler pages dev` booted in this directory discovers `.env.local` — so its state can
# hold the local stack's keys. `scripts/host-response-contract.mjs` and `scripts/deploy-pages.mjs`
# both run wrangler from a scratch directory outside the repository precisely so this stays empty.
.wrangler/

# Local evidence a run writes for a human to look at (browser screenshots, traces).
# Never committed: they name throwaway local tokens in their filenames or contents.
artifacts/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
