# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Environment files — never commit real credentials / config
.env
.env.*
!.env.example

# Supabase CLI local-stack state (recreated by `db start`, holds local keys)
supabase/.temp/
supabase/.branches/

# Local evidence a run writes for a human to look at (browser screenshots, traces).
# Never committed: they name throwaway local tokens in their filenames or contents.
artifacts/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
